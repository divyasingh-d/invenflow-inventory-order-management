# ==============================================
# InvenFlow - Environment Variables
# Copy this file to .env and fill in your values
# ==============================================

# ── Database ──────────────────────────────────
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ── Backend ───────────────────────────────────
# Full PostgreSQL connection URL (used by backend directly)
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/inventory_db

# Application settings
DEBUG=false

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80,https://your-frontend-domain.vercel.app

# ── Frontend ──────────────────────────────────
# Backend API URL (used during frontend build)
VITE_API_URL=http://localhost:8000

# ── Production Overrides ──────────────────────
# Set these for cloud deployments:
#
# VITE_API_URL=https://your-backend.onrender.com
# DATABASE_URL=postgresql://user:pass@host:5432/db
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
